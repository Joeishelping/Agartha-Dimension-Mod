{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "agartha:holy_motes",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/agartha_snowflake"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 10 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.1 },
      "minecraft:emitter_shape_box": { "half_dimensions": [9, 2, 9], "direction": [0, 1, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "3 + variable.particle_random_1 * 2" },
      "minecraft:particle_initial_speed": 0.3,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": ["math.sin(variable.particle_age * 100 + variable.particle_random_2 * 360) * 0.3", 0.25, "math.cos(variable.particle_age * 80 + variable.particle_random_3 * 360) * 0.3"],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.06 + variable.particle_random_3 * 0.05", "0.06 + variable.particle_random_3 * 0.05"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1, 0.88, 0.55, "math.sin(variable.particle_age / variable.particle_lifetime * 180)"]
      }
    }
  }
}
