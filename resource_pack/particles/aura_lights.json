{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "agartha:aura_lights",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/agartha_mist"
      }
    },
    "components": {
      "minecraft:emitter_lifetime_looping": {
        "active_time": 10
      },
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 3,
        "max_particles": 40
      },
      "minecraft:emitter_shape_box": {
        "offset": [
          0,
          2,
          0
        ],
        "half_dimensions": [
          11,
          3,
          11
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "6 + variable.particle_random_1 * 4"
      },
      "minecraft:particle_initial_speed": 0.1,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 60 + variable.particle_random_2 * 360) * 0.3",
          0.08,
          "math.cos(variable.particle_age * 50 + variable.particle_random_3 * 360) * 0.3"
        ],
        "linear_drag_coefficient": 0.8
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.28 + variable.particle_random_3 * 0.18",
          "0.28 + variable.particle_random_3 * 0.18"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "variable.particle_random_2 > 0.5 ? 1 : 0.55",
          "variable.particle_random_2 > 0.5 ? 0.85 : 0.9",
          "variable.particle_random_2 > 0.5 ? 0.45 : 1",
          "math.sin(variable.particle_age / variable.particle_lifetime * 180) * (0.7 + 0.3 * math.sin(variable.particle_age * 300))"
        ]
      }
    }
  }
}