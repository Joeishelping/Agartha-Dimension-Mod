{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "agartha:soul_wisp",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/agartha_mist"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 5
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_box": {
        "half_dimensions": [
          1.5,
          1,
          1.5
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "3 + variable.particle_random_1 * 3"
      },
      "minecraft:particle_initial_speed": 0.25,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 90 + variable.particle_random_2 * 360) * 0.4",
          0.25,
          "math.cos(variable.particle_age * 80 + variable.particle_random_3 * 360) * 0.4"
        ],
        "linear_drag_coefficient": 0.7
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.18 + variable.particle_random_3 * 0.14",
          "0.18 + variable.particle_random_3 * 0.14"
        ],
        "facing_camera_mode": "rotate_xyz",
        "uv": {
          "texture_width": 32,
          "texture_height": 32,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            32,
            32
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.45,
          0.95,
          1,
          "math.sin(variable.particle_age / variable.particle_lifetime * 180) * 0.9"
        ]
      }
    }
  }
}
