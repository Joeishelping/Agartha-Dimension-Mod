{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "agartha:snowfall",
      "basic_render_parameters": {
        "material": "particles_blend",
        "texture": "textures/particle/agartha_snowflake"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": { "num_particles": 28 },
      "minecraft:emitter_lifetime_once": { "active_time": 0.1 },
      "minecraft:emitter_shape_box": { "half_dimensions": [12, 3, 12], "direction": [0, -1, 0] },
      "minecraft:particle_lifetime_expression": { "max_lifetime": "4 + variable.particle_random_1 * 3" },
      "minecraft:particle_initial_speed": 0.8,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          "math.sin(variable.particle_age * 120 + variable.particle_random_2 * 360) * 0.6",
          -0.4,
          "math.cos(variable.particle_age * 90 + variable.particle_random_3 * 360) * 0.6"
        ],
        "linear_drag_coefficient": 1.2
      },
      "minecraft:particle_appearance_billboard": {
        "size": ["0.04 + variable.particle_random_3 * 0.05", "0.04 + variable.particle_random_3 * 0.05"],
        "facing_camera_mode": "rotate_xyz",
        "uv": { "texture_width": 8, "texture_height": 8, "uv": [0, 0], "uv_size": [8, 8] }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [1, 1, 1, "math.clamp(variable.particle_lifetime - variable.particle_age, 0, 1)"]
      },
      "minecraft:particle_appearance_lighting": {}
    }
  }
}
